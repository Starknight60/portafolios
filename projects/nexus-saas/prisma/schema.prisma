generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Usuarios del sistema
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  avatarUrl String?
  role      String   @default("MEMBER") // ADMIN | MEMBER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  OrganizationMember[]
  createdTasks Task[]               @relation("CreatedTasks")
  assignedTasks Task[]              @relation("AssignedTasks")
  auditLogs    AuditLog[]
}

// 2. Organizaciones / Empresas (Multi-Tenant)
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("ENTERPRISE") // FREE | PRO | ENTERPRISE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  OrganizationMember[]
  projects Project[]
}

// 3. Miembros y Roles dentro de la Organización (RBAC)
model OrganizationMember {
  id             String       @id @default(uuid())
  role           String       @default("DEVELOPER") // OWNER | ADMIN | DEVELOPER | VIEWER
  userId         String
  organizationId String
  createdAt      DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

// 4. Proyectos de la Organización
model Project {
  id             String       @id @default(uuid())
  name           String
  description    String?
  key            String       // Ej: "NEX", "CORE"
  status         String       @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          Task[]
}

// 5. Tareas / Tickets
model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("TODO") // TODO | IN_PROGRESS | REVIEW | DONE
  priority    String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  dueDate     DateTime?
  projectId   String
  creatorId   String
  assigneeId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator  User    @relation("CreatedTasks", fields: [creatorId], references: [id])
  assignee User?   @relation("AssignedTasks", fields: [assigneeId], references: [id])
}

// 6. Registro de Auditoría (Compliance y Seguridad)
model AuditLog {
  id         String   @id @default(uuid())
  action     String   // Ej: "USER_REGISTERED", "PROJECT_CREATED", "TASK_STATUS_CHANGED"
  entityType String   // "USER", "PROJECT", "TASK"
  details    String?
  userId     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}