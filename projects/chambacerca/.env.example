# Neon Serverless PostgreSQL (usa el mismo servidor, esquema aislado "chambacerca")
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT.neon.tech/neondb?schema=chambacerca&sslmode=require"

# Firma de sesiones. Genera una larga y aleatoria: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia_esto"

# Sal para anonimizar dispositivos en reportes de la comunidad
DEVICE_HASH_SALT="cambia_esto_tambien"
